# Runtime
APP_MODE=fixture
DATA_DIR=.data/runtime
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
DEVELOPMENT=false

# AWS bootstrap identity; live collection must assume the dedicated collector role
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=000000000000
AWS_PROFILE=
AWS_COLLECTOR_ROLE_ARN=
AWS_APPLICATION_ROLE_ARN=

# Evaluated behavior comes from a verified release/candidate manifest.
# Models, indexes, thresholds, resource scope, and budgets are not env overrides.
RELEASE_REGISTRY_DIR=.data/releases

# Optional AWS application storage
AWS_TRIGGER_QUEUE_URL=
AWS_REPORT_BUCKET=
AWS_CASE_TABLE=
AWS_CONTROL_TABLE=
AWS_TRIGGER_INBOX_TABLE=
AWS_OPENSEARCH_ENDPOINT=

# Restrictive emergency control; does not clear persisted containment when unset
INCIDENT_AGENT_SAFE_MODE=0

